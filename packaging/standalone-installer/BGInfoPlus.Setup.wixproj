<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>BGInfoPlus-$(ProductVersion)-win-x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDirectory=$(PublishDirectory);RepositoryRoot=$(RepositoryRoot)</DefineConstants>
  </PropertyGroup>
</Project>